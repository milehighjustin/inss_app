{
  "expo": {
    "name": "inss-app-v2",
    "slug": "inss-app-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inssappv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow INSS to choose a photo for an admin user profile.",
          "microphonePermission": "Allow INSS to use the microphone for Kiosk Connect calls."
        }
      ],
      "expo-sharing",
      "expo-video",
      "expo-audio",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow INSS to use the camera for Kiosk Connect calls.",
          "microphonePermission": "Allow INSS to use the microphone for Kiosk Connect calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
