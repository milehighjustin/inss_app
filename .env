# The inss-app-backend service that serves /api/mobile/*.
#
# Local development: run `npm run dev` in ../inss-app-backend (it listens on
# 3001, so it can run alongside the v1 website on 3000).
# Testing on a physical device: replace localhost with your machine's LAN IP.
# Release builds must set this to the deployed backend URL.
EXPO_PUBLIC_API_URL=http://localhost:3001
